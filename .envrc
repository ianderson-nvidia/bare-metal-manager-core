# Load the flake's dev shell: Rust toolchain, Go, cargo-make, just, and the
# build inputs the crates link against. Kept first so that everything below
# overrides the shell rather than the other way around.
#
# Plain direnv re-evaluates the flake on every entry into this directory.
# Install nix-direnv to have the result cached and rooted against the garbage
# collector: https://github.com/nix-community/nix-direnv
#use flake

export TESTDB_USER=postgres
export TESTDB_PASSWORD=admin
export TESTDB_HOST=localhost

export RUSTC_WRAPPER=sccache

# required for sqlx::test harnesses.
export DATABASE_URL=postgresql://${TESTDB_USER}:${TESTDB_PASSWORD}@${TESTDB_HOST}
export REPO_ROOT=$(git rev-parse --show-toplevel)

#create this file and put any local overrides you may need into it.
if [[ -f "./.local_envrc" ]]; then
    source ./.local_envrc
fi
